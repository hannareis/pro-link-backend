# Configuracoes gerais da aplicacao (config/app.php)
APP_NAME="Pro-Link"
APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=

# Conexao com o MariaDB (config/database.php)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=pro_link_db
DB_USERNAME=prolink
DB_PASSWORD=secret

# API REST oficial do CREA-AM, usada pelo CreaApiService (RF02)
CREA_API_BASE_URL=https://desafio-prolink.crea-am.org.br/api/index.php
CREA_API_TOKEN=

# Portal de dados abertos do governo federal, usado pelo DadosPublicosService (item 4.3)
DADOS_PUBLICOS_BASE_URL=https://dados.gov.br/api/3

# Servidor SMTP para o disparo de e-mails, usado pelo NotificacaoService (RF07)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@prolink.com
MAIL_FROM_NAME="Pro-Link"

# Seguranca de sessao (config/security.php) - true apenas em producao com HTTPS
SESSION_SECURE_COOKIE=false
