{
    "name": "otho/pro-link-backend",
    "description": "Pro-Link - Plataforma de conexao entre profissionais Confea/Crea, universitarios e empresas",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
